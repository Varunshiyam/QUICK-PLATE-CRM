# ═══════════════════════════════════════
# Quick Plate CRM — Environment Variables
# ═══════════════════════════════════════

# API Base URL (Express proxy server for Salesforce)
VITE_API_BASE_URL=http://localhost:3001/api

# Salesforce Config (Phase 3 — Backend Integration)
# VITE_SF_LOGIN_URL=https://login.salesforce.com
# VITE_SF_CLIENT_ID=your_connected_app_client_id
# VITE_SF_REDIRECT_URI=http://localhost:3000/oauth/callback

# Firebase Config (Authentication)
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# App Config
VITE_APP_NAME=Quick Plate
VITE_APP_VERSION=1.0.0
